<?xml version="1.0"?>
<launch>
  <arg name="sensor_model">
    <choice value="Helios" />
    <choice value="Bpearl" />
    <choice value="E1" />
    <choice value="EM4" />
    <choice value="EMX" />
  </arg>
  <arg name="sensor_ip" default="192.168.1.200" />
  <arg name="host_ip" default="192.168.1.102" />
  <arg name="data_port" default="6699" />
  <arg name="gnss_port" default="7788" />
  <arg name="diag_span" default="1000" />
  <arg name="launch_hw" default="true" description="Whether to connect to a real sensor (true) or to accept packet messages (false).">
    <choice value="true" />
    <choice value="false" />
  </arg>
  <arg name="config_file" default="$(find-pkg-share nebula_robosense)/config/$(var sensor_model).param.yaml"/>

  <node pkg="nebula_robosense" exec="robosense_ros_wrapper_node" name="robosense_ros_wrapper_node" output="screen">
    <param from="$(var config_file)" allow_substs="true"/>
    <param name="launch_hw" value="$(var launch_hw)"/>
    <param name="sensor_ip" value="$(var sensor_ip)"/>
    <param name="host_ip" value="$(var host_ip)"/>
    <param name="data_port" value="$(var data_port)"/>
    <param name="gnss_port" value="$(var gnss_port)"/>
    <param name="diag_span" value="$(var diag_span)"/>
  </node>

</launch>
