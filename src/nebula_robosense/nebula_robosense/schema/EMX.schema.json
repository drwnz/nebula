{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LiDAR Robosense EMX parameters.",
    "type": "object",
    "definitions": {
        "EMX": {
            "type": "object",
            "properties": {
                "host_ip": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/communication.json#/definitions/host_ip"
                },
                "sensor_ip": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/communication.json#/definitions/sensor_ip"
                },
                "data_port": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/communication.json#/definitions/data_port"
                },
                "info_port": {
                    "type": "integer",
                    "default": "7788",
                    "minimum": 0,
                    "readOnly": true,
                    "description": "Sensor info/DIFOP port."
                },
                "difop2_port": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535,
                    "description": "Optional secondary EMX info port used for DIFOP2 packets."
                },
                "packet_mtu_size": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/communication.json#/definitions/packet_mtu_size"
                },
                "launch_hw": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/hardware.json#/definitions/launch_hw"
                },
                "setup_sensor": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/hardware.json#/definitions/setup_sensor"
                },
                "frame_id": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/topic.json#/definitions/frame_id"
                },
                "diag_span": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/topic.json#/definitions/diag_span"
                },
                "dual_return_distance_threshold": {
                    "$ref": "../../../nebula_core/nebula_core_ros/schema/misc.json#/definitions/dual_return_distance_threshold"
                },
                "sensor_model": {
                    "$ref": "lidar_robosense.json#/definitions/sensor_model",
                    "enum": [
                        "EMX"
                    ]
                },
                "return_mode": {
                    "$ref": "lidar_robosense.json#/definitions/return_mode",
                    "enum": [
                        "Dual",
                        "Strongest",
                        "Last",
                        "First"
                    ]
                }
            },
            "required": [
                "host_ip",
                "sensor_ip",
                "data_port",
                "info_port",
                "packet_mtu_size",
                "launch_hw",
                "setup_sensor",
                "frame_id",
                "diag_span",
                "dual_return_distance_threshold",
                "sensor_model",
                "return_mode"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "/**": {
            "type": "object",
            "properties": {
                "ros__parameters": {
                    "$ref": "#/definitions/EMX"
                }
            },
            "required": [
                "ros__parameters"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "/**"
    ],
    "additionalProperties": false
}
